#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ -x "$SCRIPT_DIR/../.venv/bin/python" ]]; then
    PROJECT_DIR="$SCRIPT_DIR/.."
else
    PROJECT_DIR="/opt/shutdown-bot"
fi

cd "$PROJECT_DIR"
PYTHONPATH="$PROJECT_DIR/src" exec "$PROJECT_DIR/.venv/bin/python" -m shutdown_bot.cli "$@"
