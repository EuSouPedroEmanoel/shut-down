# Copie para .env e preencha. O .env está no .gitignore — nunca versione o token.

# Token do bot, obtido com o @BotFather no Telegram (comando /newbot).
TELEGRAM_BOT_TOKEN=

# IDs numéricos do Telegram autorizados, separados por vírgula.
# Vazio NEGA todos os comandos — não é "liberado para todos".
# Para descobrir o seu: rode `BOOTSTRAP=1 ./run.sh` e envie /meuid ao bot.
ALLOWED_USER_IDS=
